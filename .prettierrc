{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": [
		"prettier-plugin-svelte"
	],
	"overrides": [
		{
			"files": ["*.svelte", "+page.svelte", "+layout.svelte"],
			"options": {
			"parser": "svelte"
			}
		},
		{
			"files": ["*.ts", "+page.server.ts", "+layout.server.ts", "+server.ts"],
			"options": {
			"parser": "typescript"
			}
		}
	]
}
