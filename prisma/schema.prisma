// Lead: dog care reminders, training and a shared household log.
// Each phase adds its models in its own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  email      String   @unique
  givenName  String
  familyName String?
  password   String

  sessions          Session[]
  memberships       HouseholdMember[]
  invitesCreated    Invite[]
  filesUploaded     File[]
  careItems         CareItem[]
  occurrences       Occurrence[]
  pushSubscriptions PushSubscription[]
  logEntries        LogEntry[]
  stepsTicked       SkillStep[]
  levelChanges      SkillLevelChange[]
  weights           WeightEntry[]
  sitterLinks       SitterLink[]

  // Private calendar feed (.ics) link; only the hash of the token is stored.
  calendarTokenHash String? @unique
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Household {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  timezone  String   @default("Europe/London")

  // Pushes that would land in quiet hours wait until they end, unless the dose itself is due then.
  quietStart      String @default("22:00")
  quietEnd        String @default("07:00")
  followUpMinutes Int    @default(120) // nudge again if still not given; 0 = off

  members     HouseholdMember[]
  invites     Invite[]
  pets        Pet[]
  files       File[]
  sitterLinks SitterLink[]
}

enum HouseholdRole {
  OWNER
  MEMBER
}

model HouseholdMember {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  role        HouseholdRole @default(MEMBER)
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

// Failed sign-in attempts per email, for rate limiting (serverless-safe, no in-memory state).
model LoginThrottle {
  email       String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

// A share link that lets someone join a household. Only the SHA-256 of the token is stored.
model Invite {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  uses        Int       @default(0)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId])
}

enum PetSex {
  FEMALE
  MALE
  UNKNOWN
}

model Pet {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  name       String
  breed      String?
  sex        PetSex    @default(UNKNOWN)
  birthday   DateTime? @db.Date
  neutered   Boolean?
  weightKg   Decimal?  @db.Decimal(5, 2)
  microchip  String?
  allergies  String?
  note       String? // the handwritten line on the name card, e.g. "hates the ear drops"
  vetName    String?
  vetPhone   String?
  vetAddress String?

  photoId     String?       @unique
  photo       File?         @relation("PetPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  files       File[]        @relation("PetFiles")
  care        CareItem[]
  log         LogEntry[]
  skills      Skill[]
  weights     WeightEntry[]
  sitterNotes String? // feeding, routine and quirks, shown on the sitter card

  @@index([householdId])
}

enum FileKind {
  PHOTO
  DOCUMENT
}

// A file in the private Blob store. Served only through /files/[id] after a household check.
model File {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  kind         FileKind
  pathname     String    @unique
  contentType  String
  size         Int
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  petId        String?
  pet          Pet?      @relation("PetFiles", fields: [petId], references: [id], onDelete: Cascade)
  photoOf      Pet?      @relation("PetPhoto")
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  logEntryId   String?
  logEntry     LogEntry? @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([petId])
}

enum CareType {
  MEDICATION
  FLEA_TICK
  WORMING
  VACCINE
  APPOINTMENT
  GROOMING
  TRAINING
  CUSTOM
}

enum Repeat {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

// Something on the sheet: a med, treatment or appointment, with its repeat pattern.
// Times are wall-clock "HH:MM" in the household's timezone; doses are generated as Occurrences.
model CareItem {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  type             CareType
  title            String
  dose             String?
  notes            String?
  stock            Int? // tablets/doses left; counts down when given
  refillAt         Int? // push "running low" when stock reaches this
  refillNotifiedAt DateTime?

  repeat         Repeat
  interval       Int       @default(1) // every N days/weeks/months
  times          String[] // ["08:00", "20:00"]
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  active         Boolean   @default(true)
  generatedUntil DateTime? // occurrences exist up to here

  occurrences Occurrence[]

  @@index([petId])
}

enum OccurrenceStatus {
  PENDING
  DONE
  SKIPPED
}

// One due dose or appointment. "Given by" lives here so the whole household sees it.
model Occurrence {
  id           String           @id @default(cuid())
  careItemId   String
  careItem     CareItem         @relation(fields: [careItemId], references: [id], onDelete: Cascade)
  dueAt        DateTime
  status       OccurrenceStatus @default(PENDING)
  snoozedUntil DateTime?
  doneAt       DateTime?
  doneById     String?
  doneBy       User?            @relation(fields: [doneById], references: [id], onDelete: SetNull)
  doneByName   String? // e.g. a sitter marking it given via their link

  // Delivery: the QStash message that will push this dose, and what has been sent (idempotent).
  messageId    String?
  notifiedAt   DateTime?
  followedUpAt DateTime?

  @@unique([careItemId, dueAt])
  @@index([dueAt, status])
}

// One per phone/browser that allowed notifications.
model PushSubscription {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String? // "iPhone", "Mac" from the user agent
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  failures      Int       @default(0)

  @@index([userId])
}

enum LogType {
  TRAINING
  NOTE
  HEALTH
  WALK
}

// The household diary: training sessions, notes, health observations and walks.
model LogEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientId  String?  @unique // set by the phone so an offline entry is saved once when it syncs
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  type        LogType
  occurredAt  DateTime
  durationMin Int?
  rating      Int? // 1 rough, 2 OK, 3 great
  body        String?
  tags        String[] // health observations: "Itching", "Sickness"…

  skills       LogEntrySkill[]
  files        File[]
  levelChanges SkillLevelChange[]

  @@index([petId, occurredAt])
}

enum SkillLevel {
  LEARNING
  GETTING_THERE
  RELIABLE
}

model Skill {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  petId     String
  pet       Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
  name      String
  level     SkillLevel @default(LEARNING)

  steps        SkillStep[]
  entries      LogEntrySkill[]
  levelChanges SkillLevelChange[]

  @@unique([petId, name])
}

// Your own checklist for a skill, e.g. recall: house, then garden, then park on a long line.
model SkillStep {
  id       String    @id @default(cuid())
  skillId  String
  skill    Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  position Int
  text     String
  doneAt   DateTime?
  doneById String?
  doneBy   User?     @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@index([skillId])
}

model LogEntrySkill {
  logEntryId String
  logEntry   LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([logEntryId, skillId])
}

model SkillLevelChange {
  id         String     @id @default(cuid())
  at         DateTime   @default(now())
  skillId    String
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  from       SkillLevel
  to         SkillLevel
  byId       String?
  by         User?      @relation(fields: [byId], references: [id], onDelete: SetNull)
  logEntryId String?
  logEntry   LogEntry?  @relation(fields: [logEntryId], references: [id], onDelete: SetNull)

  @@index([skillId])
}

model WeightEntry {
  id    String   @id @default(cuid())
  at    DateTime @default(now())
  kg    Decimal  @db.Decimal(5, 2)
  petId String
  pet   Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  byId  String?
  by    User?    @relation(fields: [byId], references: [id], onDelete: SetNull)

  @@index([petId, at])
}

// A private, expiring link for a sitter: read-only card plus marking doses given. No account.
model SitterLink {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  tokenHash   String    @unique
  sitterName  String
  expiresAt   DateTime
  revokedAt   DateTime?
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([householdId])
}
