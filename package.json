{
	"name": "arlo-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && prisma generate && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:migrate": "node scripts/guard-dev-db.mjs && prisma migrate dev",
		"db:deploy": "node scripts/migrate-deploy.mjs",
		"postinstall": "svelte-kit sync && prisma generate",
		"test:unit": "vitest run",
		"test:e2e": "node scripts/guard-dev-db.mjs && node scripts/test-cert.mjs && playwright test",
		"test": "npm run test:unit && npm run test:e2e",
		"vercel-build": "prisma generate && node scripts/migrate-deploy.mjs && vite build"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-vercel": "^6.1.1",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22",
		"@types/web-push": "^3.6.4",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prisma": "^7.10.1",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"sveltekit-superforms": "^2.28.1",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2",
		"vitest": "^5.1.0",
		"zod": "^4.1.13"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource/caveat": "^5.3.0",
		"@lucide/svelte": "^0.555.0",
		"@neondatabase/serverless": "^1.0.2",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@prisma/adapter-neon": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@upstash/qstash": "^2.12.1",
		"@vercel/blob": "^2.8.2",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.3",
		"mapbox-gl": "^3.34.2",
		"web-push": "^4.0.0"
	},
	"allowScripts": {
		"@prisma/engines@7.10.1": true,
		"esbuild@0.25.12": true,
		"prisma@7.10.1": true,
		"fsevents@2.3.3": true
	}
}
